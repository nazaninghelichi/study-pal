# --- shared ---
DATABASE_URL=postgresql://postgres:secret@localhost:5432/railway

# --- Telegram bot (main.py) ---
TELEGRAM_BOT_TOKEN=
GIPHY_API_KEY=
OPENROUTER_API_KEY=

# --- web app (web_app.py) ---
SECRET_KEY=              # long random string; sessions won't survive a restart without it
PUBLIC_BASE_URL=http://localhost:5000   # used to build magic-link URLs — set to your real domain in prod

# SMTP for magic-link emails — leave unset locally to have links logged to the console instead
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
